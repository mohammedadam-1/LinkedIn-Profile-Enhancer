[Unit]
Description=LinkedIn post scraper worker (single run)
After=linkedin-api.service

[Service]
Type=oneshot
User=linkedin
WorkingDirectory=/opt/linkedin/current/Linkedin-Scraper
EnvironmentFile=/opt/linkedin/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run preflight
ExecStart=/usr/bin/env npm start
TimeoutStartSec=3600
